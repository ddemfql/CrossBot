{
  "schema_version": 1,
  "purpose": "Review snapshot; not loaded by the app and not a hosted-platform import format",
  "configuration_basis": "Current local source, not a capture of a running session",
  "entrypoint": "local_lab/app.py",
  "launcher": "start-local.cmd",
  "endpoint": "https://api.deepseek.com/chat/completions",
  "model": "deepseek-flash",
  "credential_handling": "Entered by user in local masked UI; credential value is not read or exported",
  "generation": {
    "parameters": {
      "stream": false,
      "thinking": {
        "type": "disabled"
      },
      "max_tokens": 1800,
      "response_format": {
        "type": "json_object"
      }
    },
    "timeout_seconds": 60,
    "prompt_file": "generation-system-prompt.txt",
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "english_reply": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "English Reply",
          "type": "string"
        },
        "chinese_checklist": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Chinese Checklist",
          "type": "string"
        }
      },
      "required": [
        "english_reply",
        "chinese_checklist"
      ],
      "title": "Draft",
      "type": "object"
    }
  },
  "interpretation": {
    "parameters": {
      "thinking": {
        "type": "disabled"
      },
      "stream": false,
      "max_tokens": 700,
      "response_format": {
        "type": "json_object"
      }
    },
    "timeout_seconds": 60,
    "prompt_file": "interpretation-system-prompt.txt",
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "payment_terms": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payment Terms"
        },
        "clarification": {
          "maxLength": 1000,
          "title": "Clarification",
          "type": "string"
        },
        "unsupported": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Unsupported",
          "type": "array"
        }
      },
      "required": [
        "clarification",
        "unsupported"
      ],
      "title": "ChangeProposal",
      "type": "object"
    }
  },
