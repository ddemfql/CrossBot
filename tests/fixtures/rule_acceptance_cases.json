{
  "synthetic": true,
  "description": "全部 16 条业务规则的人工值级验收样例。预期结果人工填写，使用 cross_check_cases.json 中的显式 profile。不是解析器输出或正式字段接口。",
  "limitations": "只验证比较能力。所有角色、配对、范围和字面策略均为测试假设；P1 未启用，不代表真实单据或完整业务规则已接入。",
  "rules": [
    {"rule_code": "IP-001", "kind": "text", "scope": "人工确认同一商品，采用品名字面比较", "cases": [
      {"id": "PASS", "left": "Desk Lamp", "right": "Desk Lamp", "expected": "pass", "reason": "已确认品名相同"},
      {"id": "FAIL", "left": "Desk Lamp", "right": "Desk Lamp Pro", "expected": "fail", "reason": "已配对商品的确认品名不同"},
      {"id": "MISSING", "left": null, "right": "Desk Lamp", "expected": "pending_review", "reason": "品名缺失"},
      {"id": "INVALID", "left": 123, "right": "Desk Lamp", "expected": "pending_review", "reason": "品名不是文本"},
      {"id": "UNREVIEWED", "left": "Desk Lamp", "right": "Desk Lamp", "overrides": {"left_status": "candidate"}, "expected": "pending_review", "reason": "相同但未确认"}
    ]},
    {"rule_code": "IP-002", "kind": "quantity", "scope": "已确认商品和 pcs 单位，整数数量", "cases": [
      {"id": "PASS", "left": 100, "right": 100, "expected": "pass", "reason": "数量相同"},
      {"id": "FAIL", "left": 100, "right": 120, "expected": "fail", "reason": "数量不同"},
      {"id": "MISSING", "left": 100, "right": null, "expected": "pending_review", "reason": "右侧数量缺失"},
      {"id": "INVALID", "left": "abc", "right": 100, "expected": "pending_review", "reason": "数量无法解析"},
      {"id": "UNREVIEWED", "left": 100, "right": 100, "overrides": {"right_status": "candidate"}, "expected": "pending_review", "reason": "数量未确认"}
    ]},
    {"rule_code": "IP-003", "kind": "quantity", "scope": "相同装运范围，箱数按 carton 整数计数", "overrides": {"left_unit": "carton", "right_unit": "carton"}, "cases": [
      {"id": "PASS", "left": 10, "right": 10, "expected": "pass", "reason": "箱数相同"},
      {"id": "FAIL", "left": 10, "right": 12, "expected": "fail", "reason": "箱数不同"},
      {"id": "MISSING", "left": null, "right": 10, "expected": "pending_review", "reason": "箱数缺失不能默认为零"},
      {"id": "INVALID", "left": "10.5", "right": 10, "expected": "pending_review", "reason": "整数箱数不得截断小数"},
      {"id": "UNREVIEWED", "left": 10, "right": 10, "overrides": {"left_status": "candidate"}, "expected": "pending_review", "reason": "箱数未确认"}
    ]},
    {"rule_code": "IP-004", "kind": "weight", "scope": "相同装运范围的总毛重，显式零容差", "cases": [
      {"id": "PASS", "left": "1", "right": "1000", "overrides": {"right_unit": "g"}, "expected": "pass", "reason": "毛重精确换算后相同"},
      {"id": "FAIL", "left": "10", "right": "12", "expected": "fail", "reason": "毛重不同"},
      {"id": "MISSING", "left": null, "right": "10", "expected": "pending_review", "reason": "毛重缺失"},
      {"id": "INVALID", "left": "abc", "right": "10", "expected": "pending_review", "reason": "毛重无法解析"},
      {"id": "UNREVIEWED", "left": "10", "right": "10", "overrides": {"left_status": "candidate"}, "expected": "pending_review", "reason": "毛重未确认"}
    ]},
    {"rule_code": "IP-005", "kind": "weight", "scope": "相同装运范围的总净重，显式零容差", "cases": [
      {"id": "PASS", "left": "8", "right": "8000", "overrides": {"right_unit": "g"}, "expected": "pass", "reason": "净重换算后相同"},
      {"id": "FAIL", "left": "8", "right": "9", "expected": "fail", "reason": "净重不同"},
      {"id": "MISSING", "left": "8", "right": null, "expected": "pending_review", "reason": "净重缺失"},
      {"id": "INVALID", "left": "NaN", "right": "8", "expected": "pending_review", "reason": "非有限数不可比较"},
      {"id": "UNREVIEWED", "left": "8", "right": "8", "overrides": {"right_status": "candidate"}, "expected": "pending_review", "reason": "净重未确认"}
    ]},
    {"rule_code": "CASE-001", "kind": "text", "scope": "Case 客户与单据客户角色相同，字面规则已确认", "cases": [
      {"id": "PASS", "left": "Acme Ltd", "right": "Acme Ltd", "expected": "pass", "reason": "客户一致"},
      {"id": "FAIL", "left": "Acme Ltd", "right": "Example Ltd", "expected": "fail", "reason": "客户不同"},
      {"id": "MISSING", "left": "Acme Ltd", "right": null, "expected": "pending_review", "reason": "单据客户缺失"},
      {"id": "INVALID", "left": 123, "right": "Acme Ltd", "expected": "pending_review", "reason": "客户不是文本"},
      {"id": "UNREVIEWED", "left": "Acme Ltd", "right": "Acme Ltd", "overrides": {"right_status": "candidate"}, "expected": "pending_review", "reason": "客户未确认"}
    ]},
    {"rule_code": "CASE-002", "kind": "text", "scope": "已确认目的国代码；不混用原产国或中转国", "cases": [
      {"id": "PASS", "left": "DE", "right": "DE", "expected": "pass", "reason": "目的国一致"},
      {"id": "FAIL", "left": "DE", "right": "FR", "expected": "fail", "reason": "目的国不同"},
      {"id": "MISSING", "left": null, "right": "DE", "expected": "pending_review", "reason": "目的国缺失"},
      {"id": "INVALID", "left": 123, "right": "DE", "expected": "pending_review", "reason": "目的国不是文本"},
      {"id": "UNREVIEWED", "left": "DE", "right": "DE", "overrides": {"left_status": "candidate"}, "expected": "pending_review", "reason": "目的国未确认"}
    ]},
    {"rule_code": "CASE-003", "kind": "text", "scope": "同一订单，保留前导零及大小写", "cases": [
      {"id": "PASS", "left": "PO-001", "right": "PO-001", "expected": "pass", "reason": "订单号一致"},
      {"id": "FAIL", "left": "PO-001", "right": "PO-002", "expected": "fail", "reason": "订单号不同"},
      {"id": "MISSING", "left": "PO-001", "right": null, "expected": "pending_review", "reason": "订单号缺失"},
      {"id": "INVALID", "left": 1, "right": "PO-001", "expected": "pending_review", "reason": "不将数字猜成订单标识"},
      {"id": "UNREVIEWED", "left": "PO-001", "right": "PO-001", "overrides": {"right_status": "candidate"}, "expected": "pending_review", "reason": "订单号未确认"}
    ]},
    {"rule_code": "IC-001", "kind": "text", "scope": "发票与合同中相同角色的客户，采用字面比较", "cases": [
      {"id": "PASS", "left": "Acme Ltd", "right": "Acme Ltd", "expected": "pass", "reason": "客户一致"},
      {"id": "FAIL", "left": "Acme Ltd", "right": "Example Ltd", "expected": "fail", "reason": "客户不同"},
      {"id": "MISSING", "left": null, "right": "Acme Ltd", "expected": "pending_review", "reason": "合同或发票客户缺失"},
      {"id": "INVALID", "left": 123, "right": "Acme Ltd", "expected": "pending_review", "reason": "客户格式错误"},
      {"id": "UNREVIEWED", "left": "Acme Ltd", "right": "Acme Ltd", "overrides": {"left_status": "candidate"}, "expected": "pending_review", "reason": "客户未确认"}
    ]},
    {"rule_code": "IC-002", "kind": "currency", "scope": "相同金额范围的已确认币种代码", "cases": [
      {"id": "PASS", "left": "usd", "right": "USD", "expected": "pass", "reason": "币种一致"},
      {"id": "FAIL", "left": "USD", "right": "EUR", "expected": "fail", "reason": "币种不同"},
      {"id": "MISSING", "left": null, "right": "USD", "expected": "pending_review", "reason": "币种缺失"},
      {"id": "INVALID", "left": "$", "right": "USD", "expected": "pending_review", "reason": "币种符号存在歧义"},
      {"id": "UNREVIEWED", "left": "USD", "right": "USD", "overrides": {"right_status": "candidate"}, "expected": "pending_review", "reason": "币种未确认"}
    ]},
    {"rule_code": "IC-003", "kind": "money", "scope": "同批次同税费范围的 USD 总金额，显式零容差", "cases": [
      {"id": "PASS", "left": "1000.00", "right": "1000", "expected": "pass", "reason": "金额一致"},
      {"id": "FAIL", "left": "1000", "right": "1200", "expected": "fail", "reason": "金额不同"},
      {"id": "MISSING", "left": "1000", "right": null, "expected": "pending_review", "reason": "金额缺失"},
      {"id": "INVALID", "left": "1,000", "right": "1000", "expected": "pending_review", "reason": "未约定数字分隔符"},
      {"id": "UNREVIEWED", "left": "1000", "right": "1000", "overrides": {"left_status": "candidate"}, "expected": "pending_review", "reason": "金额未确认"}
    ]},
    {"rule_code": "IC-004", "kind": "text", "scope": "仅在人工明确样例只比较条款代码时采用字面比较；不代表完整贸易条款一致", "cases": [
      {"id": "PASS", "left": "FOB", "right": "FOB", "expected": "pass", "reason": "样例的条款代码一致"},
      {"id": "FAIL", "left": "FOB", "right": "CIF", "expected": "fail", "reason": "条款代码不同"},
      {"id": "MISSING", "left": null, "right": "FOB", "expected": "pending_review", "reason": "条款缺失"},
      {"id": "INVALID", "left": 123, "right": "FOB", "expected": "pending_review", "reason": "条款不是文本"},
      {"id": "UNREVIEWED", "left": "FOB", "right": "FOB", "overrides": {"right_status": "candidate"}, "expected": "pending_review", "reason": "条款未确认"}
    ]},
    {"rule_code": "PB-001", "kind": "quantity", "scope": "相同运输范围的 packages 整数件数", "overrides": {"left_unit": "packages", "right_unit": "packages"}, "cases": [
      {"id": "PASS", "left": 10, "right": 10, "expected": "pass", "reason": "包装件数一致"},
      {"id": "FAIL", "left": 10, "right": 12, "expected": "fail", "reason": "包装件数不同"},
      {"id": "MISSING", "left": null, "right": 10, "expected": "pending_review", "reason": "件数缺失"},
      {"id": "INVALID", "left": "10.5", "right": 10, "expected": "pending_review", "reason": "包装整数计数不可截断"},
      {"id": "UNREVIEWED", "left": 10, "right": 10, "overrides": {"left_status": "candidate"}, "expected": "pending_review", "reason": "件数未确认"}
    ]},
    {"rule_code": "PB-002", "kind": "weight", "scope": "同一运输范围，两侧均为总毛重，显式零容差", "cases": [
      {"id": "PASS", "left": "10", "right": "10000", "overrides": {"right_unit": "g"}, "expected": "pass", "reason": "运输重量换算后相同"},
      {"id": "FAIL", "left": "10", "right": "12", "expected": "fail", "reason": "运输重量不同"},
      {"id": "MISSING", "left": null, "right": "10", "expected": "pending_review", "reason": "运输重量缺失"},
      {"id": "INVALID", "left": "10", "right": "10", "overrides": {"right_unit": null}, "expected": "pending_review", "reason": "重量单位缺失不可继承"},
      {"id": "UNREVIEWED", "left": "10", "right": "10", "overrides": {"right_status": "candidate"}, "expected": "pending_review", "reason": "运输重量未确认"}
    ]},
    {"rule_code": "PB-003", "kind": "text", "scope": "两侧明确是收货人，按确认的字面规则比较", "cases": [
      {"id": "PASS", "left": "Consignee A", "right": "Consignee A", "expected": "pass", "reason": "收货人一致"},
      {"id": "FAIL", "left": "Consignee A", "right": "Consignee B", "expected": "fail", "reason": "收货人不同"},
      {"id": "MISSING", "left": null, "right": "Consignee A", "expected": "pending_review", "reason": "收货人缺失"},
      {"id": "INVALID", "left": 123, "right": "Consignee A", "expected": "pending_review", "reason": "收货人不是文本"},
      {"id": "UNREVIEWED", "left": "Consignee A", "right": "Consignee A", "overrides": {"left_status": "candidate"}, "expected": "pending_review", "reason": "收货人未确认"}
    ]},
    {"rule_code": "PB-004", "kind": "text", "scope": "两侧明确是发货人，不以卖方自动替代", "cases": [
      {"id": "PASS", "left": "Shipper A", "right": "Shipper A", "expected": "pass", "reason": "发货人一致"},
      {"id": "FAIL", "left": "Shipper A", "right": "Shipper B", "expected": "fail", "reason": "发货人不同"},
      {"id": "MISSING", "left": null, "right": "Shipper A", "expected": "pending_review", "reason": "发货人缺失"},
      {"id": "INVALID", "left": 123, "right": "Shipper A", "expected": "pending_review", "reason": "发货人不是文本"},
      {"id": "UNREVIEWED", "left": "Shipper A", "right": "Shipper A", "overrides": {"right_status": "candidate"}, "expected": "pending_review", "reason": "发货人未确认"}
    ]}
  ]
}

