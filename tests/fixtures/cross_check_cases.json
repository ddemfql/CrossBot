    {"id": "TEXT-ALIAS-UNKNOWN", "kind": "text", "left": "Acme Ltd", "right": "ACME Limited", "overrides": {"context_confirmed": false}, "expected": "pending_review", "reason": "角色或别名映射未确认，不能自行模糊匹配"}
  ]
