    {"id": "CURRENCY-AMBIGUOUS", "kind": "currency", "left": "$", "right": "USD", "expected": "pending_review", "reason": "不能默认美元"},
    {"id": "IP-001-PASS", "kind": "text", "left": " Desk Lamp ", "right": "Desk Lamp", "expected": "pass", "reason": "样例采用已确认的字面比较，只去首尾空白"},
    {"id": "IP-001-FAIL", "kind": "text", "left": "Desk Lamp", "right": "Desk Lamp Pro", "expected": "fail", "reason": "已配对商品的确认品名不同"},
    {"id": "TEXT-CASE-SENSITIVE", "kind": "text", "left": "PO-001", "right": "po-001", "expected": "fail", "reason": "样例显式采用大小写敏感的字面规则"},
    {"id": "CASE-003-LEADING-ZERO", "kind": "text", "left": "001", "right": "1", "expected": "fail", "reason": "订单号保留前导零"},
